[YAML]
# 带填写提示的本地模块示例。只改 FILL_ME_* 占位值，注释可保留。
proxies+:
  - name: TikTok-ISP-Local
    # 固定节点名称；策略组按此精确名称匹配，不要改。
    type: socks5
    # 填 ISP 信息中的“代理地址 / Proxy Address”所给的代理服务器 IP。
    # 如果 ISP 给的是主机名，则按其提供值填写；不要误填“出口 IP”，除非两项相同。
    # 替换占位内容时保留左右单引号。
    server: 'FILL_ME_PROXY_HOST'
    # 填 ISP 信息中的“代理端口 / Proxy Port”数字，不加引号。
    port: FILL_ME_PROXY_PORT
    # 填 ISP 信息中的“用户名 / Username”，原样填写并保留左右单引号。
    username: 'FILL_ME_USERNAME'
    # 填 ISP 信息中的“密码 / Password”，原样填写并保留左右单引号。
    password: 'FILL_ME_PASSWORD'
    # 固定关闭 UDP；不要改。
    udp: false
    # 固定使用日本入口策略组。运行面板中还须手动选择实际的 iKuuu 日本节点。
    dialer-proxy: 日本-入口
