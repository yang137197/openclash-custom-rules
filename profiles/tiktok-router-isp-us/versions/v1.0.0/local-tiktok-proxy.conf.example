# LOCAL MODULE TEMPLATE - replace every FILL_ME value locally before enabling.
# Keep this file on the router. Never upload credentials to GitHub or cloud modules.
[YAML]
proxies+:
  - name: TikTok-ISP-Local
    type: socks5
    server: 'FILL_ME_PROXY_HOST'
    port: FILL_ME_PROXY_PORT
    username: 'FILL_ME_USERNAME'
    password: 'FILL_ME_PASSWORD'
    udp: false
    dialer-proxy: 美国