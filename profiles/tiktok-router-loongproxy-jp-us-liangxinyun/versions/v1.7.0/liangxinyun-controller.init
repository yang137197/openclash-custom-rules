#!/bin/sh /etc/rc.common
# Install only after preflight; preparing this file does not enable a service.
START=99
STOP=09
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ruby /usr/share/openclash/liangxinyun-controller.rb --lock-file /var/run/liangxinyun-controller.lock --state-file /tmp/liangxinyun-controller-status.json
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 35
    procd_close_instance
}
