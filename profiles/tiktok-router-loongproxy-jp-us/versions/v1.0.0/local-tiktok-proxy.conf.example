# 路由器本地节点模块模板，不含真实凭据。
# 修改密码时只改 password；保持 TikTok-ISP-Local 与 iKuuu 日本 dialer-proxy 前提。
# 不得将填好的本地模块提交到公共仓库。
[YAML]
proxies+:
  - name: TikTok-ISP-Local
    type: socks5
    server: 'FILL_ME_PROXY_HOST'
    port: FILL_ME_PROXY_PORT
    username: 'FILL_ME_USERNAME'
    password: 'FILL_ME_PASSWORD'
    udp: false
    dialer-proxy: 日本-入口
